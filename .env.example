# =============================================================================
# Ethian Email Client - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string.
# For local development: postgres://user:password@localhost:5432/ethian
# For Neon: find in your Neon project dashboard (use the pooled connection).
DATABASE_URL="postgres://user:password@localhost:5432/ethian"

# =============================================================================
# Redis (for BullMQ job queues)
# =============================================================================
# Redis connection URL.
# For local development: redis://localhost:6379
# For Upstash or other managed Redis: redis://:password@host:port
REDIS_URL="redis://localhost:6379"

# =============================================================================
# NextAuth.js
# =============================================================================
# Secret used to sign/encrypt JWTs and session tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# The canonical URL of your application.
# For development: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# Encryption (for IMAP/SMTP passwords stored in the database)
# =============================================================================
# AES-256-CBC encryption key for storing email account passwords.
# Must be exactly 32 bytes (64 hex characters).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-64-char-hex-encryption-key-here-generate-with-openssl"
